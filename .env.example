# Copiá este archivo a `.env` y completá los valores. `.env` NUNCA se versiona.
# Las variables sensibles van vacías a propósito: un valor vacío se trata como ausente,
# así que olvidar completar una variable obligatoria hace fallar el arranque.
# Una prueba verifica que cada variable que lee la aplicación figure acá.

# Entorno de ejecución: development, test o production
# Sensible: no | Por defecto: development
NODE_ENV=development

# Puerto HTTP del servicio
# Sensible: no | Por defecto: 3000
PORT=3000

# Nivel de log: fatal, error, warn, info, debug, trace o silent
# Sensible: no | Por defecto: info
LOG_LEVEL=info

# Zona horaria IANA por defecto de una clínica nueva
# Sensible: no | Por defecto: America/Argentina/Buenos_Aires
DEFAULT_TIMEZONE=America/Argentina/Buenos_Aires

# Límite de pedidos de las rutas públicas, con formato <n>/<s|min|h>
# Sensible: no | Por defecto: 30/min
RATE_LIMIT_PUBLIC=30/min

# Habilita los seeds. Solo el valor exacto "true" los habilita. Nunca en producción
# Sensible: no | Por defecto: false
ALLOW_SEED=false

# Hosts de base de datos donde se permiten los seeds, separados por coma
# Sensible: no | Por defecto: localhost,127.0.0.1,::1
SEED_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Conexión del rol de la aplicación (sin BYPASSRLS ni propiedad de las tablas)
# Sensible: SÍ | Obligatoria en los perfiles: app, seed
# Ejemplo: postgres://app:CAMBIAR@localhost:5432/turnos
DATABASE_URL=

# Conexión del rol de migraciones (propietario del esquema)
# Sensible: SÍ | Obligatoria en el perfil: migrate
# Ejemplo: postgres://migra:CAMBIAR@localhost:5432/turnos
DATABASE_MIGRATION_URL=

# Conexión del rol de la aplicación para las pruebas de integración (base efímera)
# Sensible: SÍ | Obligatoria en el perfil: test
# Ejemplo: postgres://app:CAMBIAR@localhost:5432/turnos_test
TEST_DATABASE_URL=

# Conexión del rol de migraciones para las pruebas de integración (base efímera)
# Sensible: SÍ | Obligatoria en el perfil: test
# Ejemplo: postgres://migra:CAMBIAR@localhost:5432/turnos_test
TEST_DATABASE_MIGRATION_URL=

# Firma del token de acceso (obligatoria desde C-06)
# Sensible: SÍ
JWT_ACCESS_SECRET=

# Firma del token de refresco (obligatoria desde C-06)
# Sensible: SÍ
JWT_REFRESH_SECRET=

# Clave del proveedor de email (obligatoria desde C-11)
# Sensible: SÍ
EMAIL_API_KEY=

# Remitente de los emails (obligatoria desde C-11)
# Sensible: no
EMAIL_FROM=

# Base de los enlaces incluidos en los emails (obligatoria desde C-15)
# Sensible: no | Ejemplo: http://localhost:3000
PUBLIC_BASE_URL=
