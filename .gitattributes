# Fines de línea estables entre Windows y Linux: todo archivo de texto se extrae con LF.
# Las migraciones SQL se verifican por huella: un CRLF cambiaría el hash.
* text=auto eol=lf

*.sql text eol=lf
*.ts text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
